      "body": {
        "contentType": "html",
        "content": "<p>Question for the HV folks: if a 110 trips E-31 and I'm the only one on site, is there anything I can do before someone certified gets there?</p>"
      },
      "channelIdentity": {
        "teamId": "3c2f1e8a-9b7d-4e6c-a5f4-1d2e3c4b5a69",
        "channelId": "19:na-compressors@thread.tacv2"
