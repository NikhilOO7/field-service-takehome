# Copy to .env and fill in OPENAI_API_KEY. All paths are relative to this folder.

# --- database (docker compose maps Postgres to host port 55432) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:55432/copilot
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:55432/copilot_test

# --- OpenAI (only model provider) ---
OPENAI_API_KEY=
ANSWER_MODEL=gpt-6.1-sol
ANSWER_EFFORT=low
ANSWER_ESCALATE_MODEL=gpt-6-astra
FAST_MODEL=gpt-6-luna
FAST_EFFORT=low
VISION_MODEL=gpt-6-astra
JUDGE_MODEL=gpt-6-astra
EMBED_MODEL=text-embedding-3-large
EMBED_DIMS=3072
RERANKER=llm

# --- inputs (given files, read-only) ---
CORPUS_ROOT=./corpus
USERS_FILE=./users.json
PERMISSIONS_FILE=./permissions.json
QUESTIONS_FILE=./eval/questions.json

# --- outputs ---
VAR_DIR=./var
REPORTS_DIR=./reports

# --- retrieval ---
TOP_K=40
CONTEXT_K=12
COVERAGE_THRESHOLD=1.5

# --- app ---
WO_APPROVER_ROLE=role-lead
DEMO_AUTH=true
SESSION_SECRET=change-me-for-anything-but-a-local-demo
